          "component_groups": [
            "hiw:move_to_waypoint"
          ]
        },
        "add": {
          "component_groups": [
            "hiw:freeze"
          ]
        }
      },
      "hiw:vanish": {
        "add": {
          "component_groups": [
            "hiw:vanish"
          ]
        }
      }
