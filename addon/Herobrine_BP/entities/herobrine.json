                "subject": "other",
                "value": "hiw_waypoint"
              },
              "max_dist": 128
            }
          ]
        },
        "minecraft:behavior.move_towards_target": {
          "priority": 2,
          "speed_multiplier": 1.0,
          "within_radius": 1.15,
          "control_flags": [
            "move",
            "look"
          ]
        },
        "minecraft:behavior.look_at_target": {
          "priority": 3,
          "look_distance": 128,
          "look_time": {
            "min": 1.0,
            "max": 3.0
          },
          "control_flags": [
            "look"
          ]
        }
      },
      "hiw:freeze": {
